{
  "mcpServers": {
    "xcode": {
      "type": "stdio",
      "command": "xcrun",
      "args": [
        "mcpbridge"
      ],
      "env": {}
    },
    "MobileBuildMCP": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mobilebuildmcp@latest",
        "mcp"
      ],
      "env": {
        "MOBILEBUILDMCP_SENTRY_DISABLED": "true"
      }
    },
    "sosumi": {
      "type": "http",
      "url": "https://sosumi.ai/mcp"
    }
  }
}